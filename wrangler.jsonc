{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "edgegate",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/admin-gate*",
      "/api/gate/*",
      "/gate/*",
      "/*"
    ]
  },

  "kv_namespaces": [
    {
      "binding": "KV"
    }
  ],

  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },

  "observability": {
    "enabled": true
  }
}
